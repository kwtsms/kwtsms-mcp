  "repository": { "type": "git", "url": "git+https://github.com/kwtsms/kwtsms-mcp.git" },
  "homepage": "https://github.com/kwtsms/kwtsms-mcp#readme",
  "license": "MIT",
  "author": "kwtSMS",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
