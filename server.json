{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kwtsms/kwtsms-mcp",
  "description": "Send SMS through kwtSMS (Kuwait): balance, Sender IDs, coverage. Preview and test mode by default.",
  "repository": {
    "url": "https://github.com/kwtsms/kwtsms-mcp",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "kwtsms-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "KWTSMS_USERNAME",
          "description": "kwtSMS API username",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "KWTSMS_PASSWORD",
          "description": "kwtSMS API password",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "KWTSMS_SENDER_ID",
          "description": "Sender ID used for every send (KWT-SMS is for testing only)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "KWTSMS_MCP_ALLOW_LIVE",
          "description": "Set to 1 to allow live sending (default: preview and test only)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
